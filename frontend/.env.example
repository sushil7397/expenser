# Where the React app should send API calls. In dev this is empty so the Vite
# proxy in vite.config.js forwards /api to http://127.0.0.1:9099. In production
# point this at your deployed Django API.
#
# Example for PythonAnywhere:
#   VITE_API_BASE=https://sushil7397.pythonanywhere.com
VITE_API_BASE=
